# --- Google Sheets (RSVP storage) ---
# Service account with access to Sheets API, shared as an Editor on the sheet below.
# See README "RSVP storage setup" for step-by-step instructions.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the service account JSON key, quotes included.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Resend (RSVP notification email) ---
# Optional: RSVP still saves to the Sheet above if these are left blank,
# but no one gets notified when a guest responds.
RESEND_API_KEY=
RSVP_FROM_EMAIL=
RSVP_NOTIFY_EMAIL=
